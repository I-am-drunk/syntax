{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://i-am-drunk.github.io/syntax/schema/syntax.mod.schema.json",
  "title": "Syntax Mod Manifest (syntax.mod.json)",
  "description": "Manifest schema for .sytx plugin, embedded engine, theme, and course archives.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "kind",
    "name",
    "tagline",
    "description",
    "version",
    "author"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": {
      "type": "integer",
      "enum": [1, 2],
      "default": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}$",
      "description": "Unique lowercase slug (e.g. focus-timer)."
    },
    "kind": {
      "type": "string",
      "enum": ["plugin", "embedded-plugin", "course"]
    },
    "name": { "type": "string", "minLength": 2 },
    "tagline": { "type": "string", "minLength": 4 },
    "description": { "type": "string", "minLength": 8 },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "object",
      "required": ["handle", "displayName"],
      "properties": {
        "handle": { "type": "string", "minLength": 2, "maxLength": 40 },
        "displayName": { "type": "string", "minLength": 2, "maxLength": 80 }
      }
    },
    "icon": { "type": "string", "default": "icon.svg" },
    "accentColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{3,8}$" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "license": { "type": "string" },
    "homepage": { "type": "string", "format": "uri" },
    "environment": {
      "type": "string",
      "enum": ["all", "course", "lesson"],
      "default": "all"
    },
    "depends": {
      "type": "object",
      "description": "Hard SemVer requirements. Use \"syntax\": \"^1.0.0\" and \"syntax-api\": \"^1.0.0\" for host compatibility.",
      "additionalProperties": { "type": "string" }
    },
    "recommends": {
      "type": "object",
      "description": "Optional companion packages.",
      "additionalProperties": { "type": "string" }
    },
    "breaks": {
      "type": "object",
      "description": "Hard incompatibilities. Blocks install/enable if matched.",
      "additionalProperties": { "type": "string" }
    },
    "conflicts": {
      "type": "object",
      "description": "Soft incompatibilities. Shows a warning before installing.",
      "additionalProperties": { "type": "string" }
    },
    "provides": {
      "type": "array",
      "description": "Virtual capabilities like engine:cartesian-graph or slot:lesson-split-pane.",
      "items": {
        "type": "string",
        "pattern": "^(?:engine|slot):[a-z0-9][a-z0-9-]{1,48}$"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "storage",
          "ui:toolbar",
          "ui:lesson-block",
          "ui:playbook",
          "ui:theme",
          "core:layout"
        ]
      }
    },
    "contributes": {
      "type": "object",
      "properties": {
        "toolbar": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "tooltip": { "type": "string" },
              "entry": { "type": "string", "default": "widget.html" },
              "defaultWidth": { "type": "integer", "minimum": 260, "maximum": 520 },
              "defaultHeight": { "type": "integer", "minimum": 180, "maximum": 640 }
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "title"],
            "properties": {
              "type": { "type": "string" },
              "title": { "type": "string" },
              "entry": { "type": "string", "default": "widget.html" },
              "minHeight": { "type": "integer", "minimum": 140, "maximum": 760 },
              "gradable": { "type": "boolean" }
            }
          }
        },
        "playbook": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "title", "formula"],
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" },
              "formula": { "type": "string" },
              "note": { "type": "string" },
              "steps": { "type": "array", "items": { "type": "string" } },
              "tip": { "type": "string" }
            }
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "label": { "type": "string" },
            "entry": { "type": "string", "default": "theme.css" },
            "light": { "type": "object", "additionalProperties": { "type": "string" } },
            "dark": { "type": "object", "additionalProperties": { "type": "string" } }
          }
        }
      }
    },
    "touchesCore": { "type": "boolean", "default": false },
    "coreTouchReason": { "type": "string" }
  }
}

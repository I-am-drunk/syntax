# Optional Firebase Auth configuration (50,000 free monthly active users, works on GitHub Pages with no custom domain).
# Copy this file to .env.local for local dev, or add these as GitHub Actions Repository Variables for production.
# When omitted, Syntax runs in Local Preview Mode so everything still works offline out of the box.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
